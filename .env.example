# Copy to .env and fill in. NEVER commit .env.
# Same Groq key and model as the old app - copy the value from the old .env
GROQ_API_KEY=gsk_your-existing-key
GROQ_MODEL=openai/gpt-oss-20b

# A NEW database (new Supabase project, or any new Postgres with pgvector). Do not reuse the old URL.
DATABASE_URL=postgresql://postgres:YOUR-NEW-PASSWORD@db.NEW-PROJECT-REF.supabase.co:5432/postgres
